#[test]
declaration scope TestGetAssetAmountMultiFamily:
    output result content GetAssetAmount

scope TestGetAssetAmountMultiFamily:
    definition result equals 
        output of GetAssetAmount with {
            -- asset: Asset.ResidentialRealPropertyLoan content
                ResidentialRealPropertyLoan {
                    -- amount: $ 100,000
                    -- real_property_status: IsResidential content 
                        ResidentialInfo {
                            -- property_type: MultiFamilyDwelling
                            -- mixed_use_residential_percent: Present content 70%
                        }
                }
        }

    assertion result.amount = $0

