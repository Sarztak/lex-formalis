> Using A_19

```catala
#[test]
declaration scope TestBaseRuleSingleFamily:
    output result content A_19.ClassifyResidentialRealPropertyLoan

scope TestBaseRuleSingleFamily:
    definition result equals
        output of A_19.ClassifyResidentialRealPropertyLoan with {
            -- rpl: A_19.ResidentialRealPropertyLoan {
                -- amount: $ 100,000
                -- real_property_status: IsResidential content A_19.ResidentialRealPropertyType.SingleFamilyDwelling
                -- mixed_use_residential_percent: Absent
                -- reasonable_assurance_within_3_years: false
                -- land_becomes_residential_within_3_years: Absent
            }
        }
    assertion result.qualifies

