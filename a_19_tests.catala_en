#[test]
declaration scope TestLandRulePass:
    output result content ClassifyResidentialRealPropertyLoan

scope TestLandRulePass:
    definition result equals
        output of ClassifyResidentialRealPropertyLoan with {
            -- rpl: ResidentialRealPropertyLoan {
                -- amount: $ 100,000
                -- real_property_status: WillBecomeResidential content LoanInfo {
                    -- property_type: ResidentialRealPropertyType.SingleFamilyDwelling
                    -- reasonable_assurance_within_3_years: true
                    -- land_becomes_residential_within_3_years: Present content true
                }
            }
        }
    assertion result.qualifies

