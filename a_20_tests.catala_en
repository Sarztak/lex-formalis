> Using A_20

```catala
#[test]
declaration scope TestIsEmployeeAllConditionsMet:
    output result content A_20.IsEmployee

scope TestIsEmployeeAllConditionsMet:
    definition result equals
        output of A_20.IsEmployee with {
            -- full_time_life_insurance_salesman: true
            -- employee_under_chapter_21: true
            -- provision: Present content Section79_GroupTermLifeInsuranceForEmployees
        }
    assertion result.is_employee

#[test]
declaration scope TestIsEmployeeNotSalesman:
    output result content A_20.IsEmployee

scope TestIsEmployeeNotSalesman:
    definition result equals
        output of A_20.IsEmployee with {
            -- full_time_life_insurance_salesman: false
            -- employee_under_chapter_21: true
            -- provision: Present content Section79_GroupTermLifeInsuranceForEmployees
        }
    assertion not result.is_employee

