#[test]
declaration scope TestCooperativeBankAllConditionsMet:
    output result content A_21_22.IsCooperativeBank

scope TestCooperativeBankAllConditionsMet:
    definition result equals
        output of A_21_22.IsCooperativeBank with {
            -- no_capital_stock: true
            -- mutual_purposes: true
            -- nonprofit: true
            -- association_type: A_19.BuildingAndLoanType.DomesticBuildingAndLoan
            -- subject_to_supervision: true
            -- business_is_savings_and_loans: true
            -- total_assets_at_close_of_taxable_year: $100,000
            -- qualifying_assets_at_close_of_taxable_year: [A_19.Asset.Cash content A_19.Cash { -- amount: $100,000 }]
        }
    assertion result.is_cooperative_bank

