## Article 1

The income tax for an individual is defined as a fixed percentage of the
individual's income over a year.

# usually you get one concrete structure on which law applies
# put all the declaration up
```catala
declaration structure Individual:
    data income content money
    data number_of_children content integer

declaration scope IncomeTaxComputation:
    input individual content Individual
    input overseas_territories content boolean
    input current_date content date
    internal tax_rate content decimal
    output income_tax content money

scope IncomeTaxComputation:
    definition income_tax equals 
        individual.income * tax_rate

declaration scope TestTaxComputation:
    internal individual content Individual
    output result content IncomeTaxComputation

scope IncomeTaxComputation:
    label article_2 definition tax_rate 
    under condition current_date < |2000-01-01|
    consequence equals 20 %

scope IncomeTaxComputation:
    label article_2 definition tax_rate 
    under condition current_date >= |2000-01-01|
    consequence equals 21 %

scope IncomeTaxComputation:
    label article_3 exception article_2
    definition tax_rate
    under condition individual.number_of_children >= 2
    consequence equals 15 %

scope IncomeTaxComputation:
    label article_4 exception article_3
    definition tax_rate
    under condition individual.income <= $10,000
    consequence equals 0%

scope IncomeTaxComputation:
    label article_5 exception article_3
    definition tax_rate
    under condition individual.income > $100,000
    consequence equals 30%

scope IncomeTaxComputation:
    label article_6 exception article_5
    definition tax_rate
    under condition individual.income > $100,000 and overseas_territories
    consequence equals 25%

declaration scope HouseholdTaxComputation:
    input individuals content list of Individual
    input overseas_territories content boolean
    input current_date content date
    output household_tax content money

scope HouseholdTaxComputation:
    definition household_tax equals 
    Money.sum of 
        map each individual among individuals to (
            output of HouseholdTaxIndividualComputation with {
                -- individual: individual
                -- overseas_territories: overseas_territories
                -- current_date: current_date
            }
        ).individual_household_tax

declaration scope HouseholdTaxIndividualComputation:
    input individual content Individual
    input overseas_territories content boolean
    input current_date content date
    internal individual_tax content money

    output individual_household_tax content money
        state base
        state with_deduction

scope HouseholdTaxIndividualComputation:
   definition individual_tax equals 
   (output of IncomeTaxComputation with {
        -- individual: individual
        -- overseas_territories: overseas_territories
        -- current_date: current_date
    }).income_tax
    definition individual_household_tax state base equals
        $10,000 * (1.0 + individual.number_of_children / 2)

scope HouseholdTaxIndividualComputation:
    definition individual_household_tax state with_deduction equals
    if individual_tax < individual_household_tax then individual_household_tax - individual_tax else $0

scope TestTaxComputation:
    definition individual equals 
    Individual {
        -- income: $500,000.00
        -- number_of_children: 3
    }
    definition result equals
        output of IncomeTaxComputation with {
        -- individual: individual
        -- overseas_territories: true
        -- current_date: |2025-04-01|
    }

declaration scope TestHouseholdComputation:
    output computation content HouseholdTaxComputation

scope TestHouseholdComputation:
    definition computation equals 
        output of HouseholdTaxComputation with {
            -- individuals:
            [ Individual {
                -- income: $15,000
                -- number_of_children: 0
            } ;
            Individual{
                -- income: $80,000
                -- number_of_children: 2
            } ]
            -- overseas_territories: false
            -- current_date: |1999-01-01|
        }

declaration scope TestIndividualHousehold:
    output computation content HouseholdTaxIndividualComputation

scope TestIndividualHousehold:
    definition computation equals 
    output of HouseholdTaxIndividualComputation with {
        -- individual: Individual {
            -- income: $15,000
            -- number_of_children: 0
        }
        -- overseas_territories: false
        -- current_date: |1999-01-01|
    }
```
